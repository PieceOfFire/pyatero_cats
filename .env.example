# Obtain a token from @BotFather. Never commit real credentials.
BOT_TOKEN=
# Paste Neon pooled connection string including sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
MODE=polling
# Render sets RENDER_EXTERNAL_URL automatically. Override only if needed.
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
PORT=10000
# Main administrator: numeric Telegram ID from /id (not @username or login code).
ADMIN_ID=
# Optional additional administrator IDs, comma-separated.
ADMIN_IDS=
# Private chat/channel where this bot can post imported photos.
MEDIA_CHAT_ID=
BOT_TITLE=Пятеро котят
BAND_URL=
TIMEZONE=Asia/Novosibirsk
INITIAL_SPINS=3
DAILY_SPINS=3
# streak: legacy rewards +1/+2/+3; fixed: use DAILY_SPINS every day.
DAILY_REWARD_MODE=streak
# Optional channel subscription reward. Bot must be a channel administrator.
BONUS_CHANNEL=
BONUS_CHANNEL_URL=
SUBSCRIPTION_SPINS=3
MAX_SPINS=999
MAX_CONCURRENT_UPDATES=8
DB_POOL_MAX=5
# Optional Mail WebDAV. Use an app password, not your mailbox password.
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_BACKUP_DIR=/pyatero-cats/backups
PG_DUMP_PATH=pg_dump
